# ---------------------------------------------------------------------------
# Nexora Hub – Beispielkonfiguration. Kopieren nach ".env" und Werte anpassen.
# Diese Datei enthält KEINE echten Geheimnisse und ist für Git bestimmt.
# ---------------------------------------------------------------------------

# ===================== PostgreSQL ==========================================
# Verbindung zur vorhandenen PostgreSQL-Datenbank (URL- oder ADO.NET-Format).
# WICHTIG: Es wird ausschließlich das Schema "nexora" verwaltet; das
# Wharf-Schema "public" wird niemals berührt.
NEXORA_DB=postgres://BENUTZER:PASSWORT@HOST:5432/DATENBANK
NEXORA_SCHEMA=nexora

# ===================== JWT / Authentifizierung ============================
# Symmetrischer JWT-Schlüssel (mindestens 32 Byte). In Produktion zwingend.
# Erzeugen z. B. mit: openssl rand -base64 48
NEXORA_JWT_KEY=
NEXORA_JWT_ISSUER=Nexora
NEXORA_JWT_AUDIENCE=NexoraClients
NEXORA_JWT_ACCESS_MINUTES=60
NEXORA_JWT_REFRESH_DAYS=30

# ===================== LiteLLM (KI-Backend) ===============================
# URL und API-Schlüssel werden ausschließlich im API-Container konfiguriert
# und nie an Browser oder Windows-App übertragen.
NEXORA_LITELLM_URL=
NEXORA_LITELLM_KEY=
NEXORA_LITELLM_DEFAULT_MODEL=

# ===================== Einmaliger Admin-Bootstrap ==========================
# Optionales zusätzliches Geheimnis (X-Bootstrap-Secret), z. B. wenn die
# Ersteinrichtung per Web-Panel hinter einem Reverse Proxy erfolgen soll.
# Erzeugen z. B. mit: openssl rand -base64 32
NEXORA_BOOTSTRAP_SECRET=

# ===================== Migrationen & Betrieb ==============================
# 1 = Migrationen automatisch beim Start anwenden (Standard: aus – dann
# kontrolliert via: docker compose run --rm nexora-api --migrate)
NEXORA_AUTO_MIGRATE=0
# 1 = X-Forwarded-* Header des Reverse Proxy vertrauen. Nur aktivieren, wenn
# die Container ausschließlich hinter dem Reverse Proxy erreichbar sind.
NEXORA_USE_FORWARDED_HEADERS=0
# CORS: kommagetrennte erlaubte Origins. Leer = keine Cross-Origin-Erlaubnis
# (nur in Entwicklung erlaubt das Panel Cross-Origin ohne Einschränkung).
NEXORA_CORS_ORIGINS=

# ASP.NET Core Umgebung: Development oder Production
ASPNETCORE_ENVIRONMENT=Development
# Log-Level: Verbose, Debug, Information, Warning, Error
NEXORA_LOG_LEVEL=Information

# ===================== Docker Compose (Container-Betrieb) ==================
# Ports/Bindung der Container nach außen. Innen sind API und Web immer auf
# http://+:8080 erreichbar (nicht frei konfigurierbar – bewusst fixiert).
NEXORA_API_HTTP_PORT=5199
NEXORA_WEB_HTTP_PORT=5100
NEXORA_API_BIND_IP=0.0.0.0
NEXORA_WEB_BIND_IP=0.0.0.0
NEXORA_IMAGE_TAG=latest
NEXORA_ENVIRONMENT=Production

# PostgreSQL-Bestandteile für den Docker-Betrieb (externer Server).
# Lassen sich im Fall der vorhandenen Wharf-Instanz direkt aus der
# NEXORA_DB-URL ableiten. Logs/Beispiele -> DEPLOYMENT.md.
NEXORA_DB_HOST=
NEXORA_DB_PORT=5432
NEXORA_DB_NAME=
NEXORA_DB_USER=
NEXORA_DB_PASSWORD=
NEXORA_DB_SSL_MODE=Prefer