<Application x:Class="Nexora.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexora.Desktop.Converters"
             xmlns:vm="clr-namespace:Nexora.Desktop.ViewModels"
             xmlns:views="clr-namespace:Nexora.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme/ThemeResources.xaml"/>
                <ResourceDictionary>
                    <DataTemplate DataType="{x:Type vm:ChatViewModel}">
                        <views:ChatView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LicensesViewModel}">
                        <views:LicensesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                        <views:DevicesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:LicenseStatusTextConverter x:Key="LicenseStatusText"/>
            <conv:LicenseStatusBrushConverter x:Key="LicenseStatusBrush"/>
            <conv:ChatRoleTextConverter x:Key="ChatRoleText"/>
            <conv:CostTextConverter x:Key="CostText"/>
            <conv:BoolToEstimatedTextConverter x:Key="BoolToEstimatedText"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>