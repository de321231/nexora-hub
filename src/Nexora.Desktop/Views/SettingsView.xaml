<UserControl x:Class="Nexora.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,26" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource H1Text}" Margin="0,0,0,18"/>

            <!-- API -->
            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="API-Adresse" Style="{StaticResource H2Text}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12">
                        Die Nexora-AI-Desktop-App kommuniziert ausschließlich mit der Nexora-API.
                        Der LiteLLM-Schlüssel verbleibt serverseitig und wird nie an diese App übertragen.
                    </TextBlock>
                    <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,14,0,0"
                            HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Konto -->
            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Konto" Style="{StaticResource H2Text}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" Style="{StaticResource MutedText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UserName}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="E-Mail" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UserEmail}" Margin="0,6,0,0"/>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,14,0,0">
                        Sitzung: Zugriffs- und Refresh-Tokens werden ausschließlich verschlüsselt (DPAPI, CurrentUser)
                        auf diesem Gerät gespeichert. Abmeldung widerruft den Refresh-Token serverseitig.
                    </TextBlock>

                    <Button Content="Abmelden" Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}"
                            Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Über -->
            <Border Style="{StaticResource CardBorder}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Über" Style="{StaticResource H2Text}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0">
                        Nexora AI Desktop · Version <Run Text="{Binding AppVersion}"/> · native WPF-App · MVVM
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>