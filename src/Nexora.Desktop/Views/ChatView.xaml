<UserControl x:Class="Nexora.Desktop.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700">
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Unterhaltungen -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Unterhaltungen" Style="{StaticResource H2Text}" Margin="4,4,0,12"/>

                <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="+  Neue Unterhaltung"
                        Command="{Binding NewConversationCommand}" Margin="0,0,0,12"/>

                <ListBox Grid.Row="2" ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                <Button Content="✕" Style="{StaticResource IconButton}" FontSize="11" Padding="4,0"
                                        HorizontalAlignment="Right" Margin="0,-26,0,0"
                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Chatbereich -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopfleiste -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Modell" Style="{StaticResource MutedText}" FontSize="11"/>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"
                                  DisplayMemberPath="DisplayName" MinWidth="240" MaxWidth="280"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LicenseBadge}" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding QuotaText}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding QuotaDetail}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="🔄"
                            Command="{Binding RefreshCommand}" ToolTip="Aktualisieren" Margin="0,0,0,0"/>
                </Grid>
            </Border>

            <!-- Nachrichten -->
            <ScrollViewer x:Name="MessageScroller" Grid.Row="1" Padding="20,14" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <!-- Benutzer -->
                                    <Border MaxWidth="560" HorizontalAlignment="Right"
                                            Background="#241F37" CornerRadius="14,14,4,14" Padding="14,10"
                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Du" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"
                                                       FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- KI / System -->
                                    <StackPanel MaxWidth="640" HorizontalAlignment="Left"
                                                Visibility="{Binding IsUser, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="{Binding Author}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="0,0,0,3"/>
                                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4,14,14,14" Padding="14,10">
                                            <RichTextBox Document="{Binding Document}" BorderThickness="0"
                                                          Background="Transparent" VerticalScrollBarVisibility="Disabled"
                                                          IsDocumentEnabled="True" IsReadOnly="True"/>
                                        </Border>
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Ladeindikator -->
                    <Border HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="14,10"
                            Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,6,10,0"/>
                            <TextBlock Text="Wird geladen …" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Eingabe -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,1,0,0" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="InputBox" Grid.Column="0" MinHeight="54" MaxHeight="140"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="InputBox_OnKeyDown" ToolTip="Enter zum Senden, Shift+Enter für Zeilenumbruch"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Senden" FontWeight="SemiBold" MinWidth="110"
                                Command="{Binding SendCommand}" IsEnabled="{Binding InputEnabled}" Margin="0,0,0,6"/>
                        <TextBlock Text="Enter ⌅" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Statusleiste -->
            <Border Grid.Row="3" Background="#201A2E" Padding="16,6"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>