<Window x:Class="Nexora.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Nexora.Desktop.Views"
        mc:Ignorable="d"
        Title="Nexora AI" Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- 1) Login (nicht angemeldet) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InvBoolToVis}}">
            <views:LoginView DataContext="{Binding Login}"/>
        </Grid>

        <!-- 2) Shell (angemeldet) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="0,0,1,0">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,8,0,26">
                        <TextBlock Text="NEXORA AI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"/>
                        <TextBlock Text="Desktop" Style="{StaticResource MutedText}" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavChat" GroupName="nav" Style="{StaticResource SidebarButton}" Content="💬  Chat"
                                     Command="{Binding NavigateToChatCommand}" Checked="OnNavChecked" Margin="0,0,0,2"/>
                        <RadioButton GroupName="nav" Style="{StaticResource SidebarButton}" Content="🔑  Lizenzen"
                                     Command="{Binding NavigateToLicensesCommand}" Margin="0,0,0,2"/>
                        <RadioButton GroupName="nav" Style="{StaticResource SidebarButton}" Content="🖥️  Geräte"
                                     Command="{Binding NavigateToDevicesCommand}" Margin="0,0,0,2"/>
                        <RadioButton GroupName="nav" Style="{StaticResource SidebarButton}" Content="⚙️  Einstellungen"
                                     Command="{Binding NavigateToSettingsCommand}" Margin="0,0,0,2"/>
                    </StackPanel>

                    <!-- Benutzer + Logout -->
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserEmail}" Style="{StaticResource MutedText}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Anmeldungen sind gerätegebunden und per DPAPI geschützt."
                                           Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource DangerButton}" Content="Abmelden"
                                Command="{Binding Settings.LogoutCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inhalt -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>