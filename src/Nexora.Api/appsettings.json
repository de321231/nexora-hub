{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Nexora",
    "Audience": "NexoraClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "LiteLlm": {
    "BaseUrl": "",
    "ApiKey": "",
    "DefaultModel": "",
    "TimeoutSeconds": 120
  },
  "Bootstrap": {
    "Secret": ""
  }
}
